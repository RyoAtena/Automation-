# ============================================================================
# NEXUS ARENA - Game Center Management & Rental System
# Environment Configuration Example (Copy to .env and fill in real credentials)
# NEVER commit your actual .env file or service-account.json to version control.
# ============================================================================

APP_NAME="Nexus Arena Gaming & Rental"
APP_ENV=local
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_SECRET=change_this_to_a_random_32_byte_hex_secret_key

# ----------------------------------------------------------------------------
# DATABASE & FIREBASE CONFIGURATION
# ----------------------------------------------------------------------------
# DB_DRIVER options:
#   auto            - Uses Cloud Firestore REST API if FIREBASE_PROJECT_ID and
#                     Service Account / API Key are configured; otherwise falls
#                     back cleanly to the Local Firestore-Compatible ACID Engine.
#   firebase        - Strictly uses Google Cloud Firestore & Firebase Auth REST API.
#   local_firestore - Uses the local SQLite-backed Firestore document & collection
#                     engine (100% compatible with the 17 Firestore collections).
DB_DRIVER=auto

# Firebase Project Settings (from Firebase Console -> Project Settings)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_DATABASE_ID=(default)

# Firebase Admin Service Account (for trusted server-side Firestore & Auth operations)
# Either provide a path to the JSON key file outside public/ OR set email + private key:
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local Firestore Engine Storage Path (used when DB_DRIVER=local_firestore or auto without cloud keys)
LOCAL_FIRESTORE_PATH=storage/firestore_local.sqlite
LOCAL_FIRESTORE_MIRROR_JSON=true

# ----------------------------------------------------------------------------
# AI CHATBOT CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
# If AI_API_KEY is left empty, the system automatically uses the clearly labeled
# "Live Database FAQ & Business Intelligence Assistant" powered by real-time
# room, game, controller, menu, and rate data.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# SEED DATA CONFIGURATION
# ----------------------------------------------------------------------------
AUTO_SEED_DEMO_DATA=true
